#!/bin/bash
# Shared by the runner's entrypoints: turns NP_INSTALL_CONTEXT into the tfvars
# the runner root takes, resolving through the API whatever the installer did
# not give (targets, IAM providers). An organization with its own Terraform
# fills those variables from its own outputs and never runs this. Sourced,
# not executed. Everything it prints goes to stderr; stdout is the report.
set -euo pipefail

log() { echo "$*" >&2; }
fail() { log "❌ $*"; exit 1; }

[ -n "${NP_INSTALL_CONTEXT:-}" ] || fail "NP_INSTALL_CONTEXT is not set"
[ -n "${NP_INSTALL_STATE:-}" ] || fail "NP_INSTALL_STATE is not set (path of the state file the runner keeps)"
for tool in jq curl tofu; do command -v "$tool" >/dev/null || fail "$tool is required"; done

# Credentials come from the environment, never from the context: the same
# convention the worker follows (the agent sets NP_API_KEY; np and the
# Terraform provider read NULLPLATFORM_API_KEY). NULLPLATFORM_HOST is the
# provider's own variable for the API host.
if [ -z "${NULLPLATFORM_API_KEY:-}" ] && [ -n "${NP_API_KEY:-}" ]; then
  export NULLPLATFORM_API_KEY="$NP_API_KEY"
fi
[ -n "${NULLPLATFORM_API_KEY:-}" ] || fail "NULLPLATFORM_API_KEY (or NP_API_KEY) is not set"
NP_API_URL="https://${NULLPLATFORM_HOST:-api.nullplatform.com}"
export NP_API_URL

CONTEXT="$NP_INSTALL_CONTEXT"
ctx() { jq -r "$1" <<<"$CONTEXT"; }

INSTALLATION_NRN=$(ctx '.installation.nrn // empty')
[ -n "$INSTALLATION_NRN" ] || fail "context has no installation.nrn"
[ -n "$(ctx '.installation.id // empty')" ] || fail "context has no installation.id"
[ -n "$(ctx '.agent.role_arn // empty')" ] || fail "context has no agent.role_arn"

# ── API access ──────────────────────────────────────────────────────────────────
NP_TOKEN=$(curl -sf -X POST "$NP_API_URL/token" -H 'content-type: application/json' \
  -d "{\"api_key\":\"$NULLPLATFORM_API_KEY\"}" | jq -r '.access_token // empty')
[ -n "$NP_TOKEN" ] || fail "could not exchange the API key for a token at $NP_API_URL"
export NP_TOKEN

np_get() { curl -sf "$NP_API_URL$1" -H "authorization: Bearer $NP_TOKEN"; }

# Providers are listed at an exact NRN; the platform resolves them walking up
# the hierarchy, so discovery does the same: the first level with a match wins.
ancestors() {
  local nrn="$1"
  while [ -n "$nrn" ]; do
    echo "$nrn"
    [[ "$nrn" == *:* ]] || break
    nrn="${nrn%:*}"
  done
}

# providers_by_slug <specification slug> [dimensions as key:value,…] → JSON array
providers_by_slug() {
  local slug="$1" dimensions="${2:-}" nrn results
  for nrn in $(ancestors "$INSTALLATION_NRN"); do
    results=$(np_get "/provider?nrn=$nrn&specification_slug=$slug${dimensions:+&dimensions=$dimensions}&limit=100" \
      | jq -c --arg nrn "$nrn" '[.results[]? | select(.nrn == $nrn)]')
    if [ "$(jq 'length' <<<"$results")" -gt 0 ]; then
      echo "$results"
      return 0
    fi
  done
  echo '[]'
}

dimensions_query() { jq -r 'to_entries | map("\(.key):\(.value)") | join(",")' <<<"$1"; }

# What this installation already owns, from the previous run's report kept in
# the state. Discovery must not "find" it: a found resource leaves the
# configuration, and OpenTofu would destroy what it still holds in state.
OWNED='[]'
if [ -s "$NP_INSTALL_STATE" ]; then
  OWNED=$(jq -c '[.outputs.resources.value[]? | select(.ownership == "owned") | { type, id }]' "$NP_INSTALL_STATE" 2>/dev/null || echo '[]')
fi
owned() { jq -e --arg t "$1" --arg id "$2" 'any(.[]; .type == $t and .id == $id)' <<<"$OWNED" >/dev/null; }

# ── Targets: given, or one per cloud provider the NRN resolves ──────────────────
TARGETS=$(ctx '.parameters.targets // empty')
if [ -z "$TARGETS" ] || [ "$TARGETS" = "null" ]; then
  log "🔍 Discovering targets: aws-configuration providers from $INSTALLATION_NRN"
  CLOUD=$(providers_by_slug aws-configuration)
  [ "$(jq 'length' <<<"$CLOUD")" -gt 0 ] || fail "no cloud provider (aws-configuration) resolves at $INSTALLATION_NRN: configure one there or above, or pass parameters.targets"
  TARGETS=$(jq -c '[.[] | { key: (if (.dimensions | length) == 0 then "default" else (.dimensions | to_entries | sort_by(.key) | map(.value) | join("-")) end),
                           value: { dimensions: .dimensions, region: .attributes.account.region } }] | from_entries' <<<"$CLOUD")
fi

# Channels are per target (the agent is per account): the ones that already
# route this package at the NRN, matched below by dimensions.
PACKAGE_SLUG=$(ctx '.installation.package_slug // empty')
CHANNELS=$(np_get "/notification/channel?nrn=$INSTALLATION_NRN&type=agent&limit=100" \
  | jq -c --arg nrn "$INSTALLATION_NRN" --arg pkg "$PACKAGE_SLUG" \
    '[.results[]? | select(.nrn == $nrn and .status == "active" and (.configuration.command.data.package // "") == $pkg) | { id, filters: (.filters | tojson) }]')

# ── Per target: IAM provider and channel, given or discovered for its dimensions ─
RESOLVED='{}'
for key in $(jq -r 'keys[]' <<<"$TARGETS"); do
  target=$(jq -c --arg k "$key" '.[$k]' <<<"$TARGETS")
  dims=$(jq -c '.dimensions // {}' <<<"$target")
  iam_provider_id=$(jq -r '.iam_provider_id // empty' <<<"$target")
  if [ -z "$iam_provider_id" ]; then
    iam_provider_id=$(providers_by_slug aws-iam-configuration "$(dimensions_query "$dims")" | jq -r '.[0].id // empty')
    if [ -n "$iam_provider_id" ] && owned provider_config "$iam_provider_id"; then
      iam_provider_id=''
      log "   target $key: IAM provider is this installation's own"
    fi
    if [ -n "$iam_provider_id" ]; then log "   target $key: IAM provider $iam_provider_id found, adopting it"; else log "   target $key: no IAM provider; one will be created (or kept)"; fi
  fi
  role_arn=$(jq -r '.role_arn // empty' <<<"$target")
  if [ -n "$role_arn" ]; then log "   target $key: role provided"; else log "   target $key: role will be created (or kept)"; fi

  # Channel: given, or the one already routing this package for these
  # dimensions (every dimension named in its filters; none when the target
  # has none), unless it is this installation's own.
  channel_id=$(jq -r '.channel_id // empty' <<<"$target")
  if [ -z "$channel_id" ]; then
    while IFS=$'\t' read -r cid cfilters; do
      [ -n "$cid" ] || continue
      if [ "$(jq 'length' <<<"$dims")" -eq 0 ]; then
        [[ "$cfilters" == *dimensions.* ]] && continue
      else
        match=true
        while IFS=$'\t' read -r dk dv; do
          [[ "$cfilters" == *"service.dimensions.$dk"*"\"$dv\""* ]] || match=false
        done < <(jq -r 'to_entries[] | "\(.key)\t\(.value)"' <<<"$dims")
        [ "$match" = true ] || continue
      fi
      channel_id="$cid"; break
    done < <(jq -r '.[] | "\(.id)\t\(.filters)"' <<<"$CHANNELS")
    if [ -n "$channel_id" ] && owned notification_channel "$channel_id"; then channel_id=''; log "   target $key: channel is this installation's own"; fi
    if [ -n "$channel_id" ]; then log "   target $key: channel $channel_id already routes the package for these dimensions, reusing it"; else log "   target $key: channel will be created (or kept)"; fi
  fi
  agent_tags=$(jq -c '.agent_tags // empty' <<<"$target")

  RESOLVED=$(jq -c --arg k "$key" --argjson dims "$dims" --arg role "$role_arn" --arg iam "$iam_provider_id" --arg channel "$channel_id" --argjson tags "${agent_tags:-null}" '
    def nz: if . == "" then null else . end;
    .[$k] = { dimensions: $dims, role_arn: ($role | nz), iam_provider_id: ($iam | nz), channel_id: ($channel | nz), agent_tags: $tags }' <<<"$RESOLVED")
done

AWS_REGION_DEFAULT=$(jq -r '[.[] | .region // empty][0] // "us-east-1"' <<<"$TARGETS")

# ── tfvars and working directory ────────────────────────────────────────────────
# The runner root is used in place: its module sources are relative paths.
TF_WORKING_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TF_STATE="$NP_INSTALL_STATE"
INSTALLATION_ID=$(ctx '.installation.id')
TF_VARS_FILE="${TMPDIR:-/tmp}/np-installation-$INSTALLATION_ID.tfvars.json"
umask 077
jq -n --argjson ctx "$CONTEXT" --argjson targets "$RESOLVED" --arg region "$AWS_REGION_DEFAULT" '{
  installation: { id: $ctx.installation.id, nrn: $ctx.installation.nrn,
                  package_slug: $ctx.installation.package_slug, version: $ctx.installation.version },
  agent: { role_arn: $ctx.agent.role_arn, tags: ($ctx.agent.tags // {}) },
  targets: $targets,
  aws_region: $region,
  create_channel: ($ctx.parameters.create_channel // true)
}' > "$TF_VARS_FILE"
export TF_WORKING_DIR TF_STATE TF_VARS_FILE

tofu_run() {
  tofu -chdir="$TF_WORKING_DIR" init -input=false >&2
  tofu -chdir="$TF_WORKING_DIR" "$@"
}

# The report: tofu outputs in the contract's shape, on stdout.
report() {
  tofu -chdir="$TF_WORKING_DIR" output -json -state="$TF_STATE" \
    | jq '{ outputs: (.outputs.value // {}), resources: (.resources.value // []), missing: (.missing.value // []) }'
}
