{
  "name": "@nullplatform/plugin-s3-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun build --compile ./src/index.ts --outfile dist/s3-browser",
    "describe": "bun src/index.ts --describe",
    "publish:image": "bash scripts/publish-image.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/credential-providers": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@nullplatform/plugin": "0.0.5",
    "config": "^4.4.2"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "json-schema-to-ts": "^3.1.1",
    "typescript": "^5.6.0"
  },
  "trustedDependencies": ["@grpc/grpc-js"]
}
