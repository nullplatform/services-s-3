{
  "slug": "aws-s3-bucket",
  "name": "AWS S3 bucket",
  "schema": {
    "type": "object",
    "required": [
      "bucket_name",
      "region",
      "nrn"
    ],
    "properties": {
      "bucket_name": {
        "type": "string",
        "primaryKey": true,
        "autoGenerate": false
      },
      "region": {
        "type": "string",
        "index": [
          "filter",
          "facet"
        ]
      },
      "nrn": {
        "type": "string",
        "nrn": true
      },
      "service_id": {
        "type": "string",
        "index": [
          "filter"
        ]
      }
    },
    "actions": {
      "list-objects": {
        "name": "List objects",
        "execution": "sync",
        "input": {
          "type": "object",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "prefix": {
              "type": "string",
              "maxLength": 1024,
              "pattern": "^[^/]",
              "title": "Prefix",
              "description": "Relative key prefix, usually ending in /"
            },
            "token": {
              "type": "string",
              "title": "Continuation token"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 200,
              "title": "Limit"
            }
          }
        },
        "output": {
          "type": "object",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "required": [
            "bucket",
            "region",
            "prefix",
            "folders",
            "objects",
            "next_token",
            "truncated"
          ],
          "properties": {
            "bucket": {
              "type": "string"
            },
            "region": {
              "type": [
                "string",
                "null"
              ]
            },
            "prefix": {
              "type": "string"
            },
            "folders": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "prefix",
                  "name"
                ],
                "properties": {
                  "prefix": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            },
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "name",
                  "size",
                  "last_modified"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "size": {
                    "type": "number"
                  },
                  "last_modified": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "storage_class": {
                    "type": "string"
                  },
                  "etag": {
                    "type": "string"
                  }
                }
              }
            },
            "next_token": {
              "type": [
                "string",
                "null"
              ]
            },
            "truncated": {
              "type": "boolean"
            }
          }
        }
      },
      "head-object": {
        "name": "Head object",
        "execution": "sync",
        "input": {
          "type": "object",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "additionalProperties": false,
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^/].*[^/]$|^[^/]$",
              "title": "Key",
              "description": "Relative object key (no leading or trailing slash)"
            }
          }
        },
        "output": {
          "type": "object",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "required": [
            "key",
            "size",
            "last_modified",
            "metadata"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "size": {
              "type": "number"
            },
            "content_type": {
              "type": "string"
            },
            "last_modified": {
              "type": [
                "string",
                "null"
              ]
            },
            "etag": {
              "type": "string"
            },
            "storage_class": {
              "type": "string"
            },
            "metadata": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      },
      "presign-download": {
        "name": "Presign download",
        "execution": "sync",
        "input": {
          "type": "object",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "additionalProperties": false,
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^/].*[^/]$|^[^/]$",
              "title": "Key",
              "description": "Relative object key (no leading or trailing slash)"
            }
          }
        },
        "output": {
          "type": "object",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "required": [
            "key",
            "url",
            "expires_at"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "expires_at": {
              "type": "string"
            }
          }
        }
      },
      "delete-object": {
        "name": "Delete object",
        "execution": "sync",
        "input": {
          "type": "object",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "additionalProperties": false,
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^/].*[^/]$|^[^/]$",
              "title": "Key",
              "description": "Relative object key (no leading or trailing slash)"
            }
          }
        },
        "output": {
          "type": "object",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string"
            }
          }
        }
      }
    },
    "authorization": {
      "entities": {
        "grants": [
          {
            "principals": [
              {
                "type": "*"
              }
            ],
            "actions": [
              "read",
              "list",
              "action:list-objects",
              "action:head-object",
              "action:presign-download"
            ]
          }
        ]
      }
    }
  }
}
