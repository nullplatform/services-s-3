{
  "name": "Delete object",
  "slug": "delete-object",
  "type": "custom",
  "parallelize": true,
  "permission": "custom:s3:objectdelete",
  "parameters": {
    "schema": {
      "type": "object",
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^/].*[^/]$|^[^/]$",
          "title": "Key",
          "description": "Relative object key (no leading or trailing slash)"
        }
      }
    },
    "values": {}
  },
  "results": {
    "schema": {
      "type": "object",
      "$schema": "http://json-schema.org/draft-07/schema#",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string"
        }
      }
    },
    "values": {}
  }
}
