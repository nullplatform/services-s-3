{
  "slug": "s3_browser",
  "name": "S3 browser",
  "description": "One entity per application: browse the S3 buckets linked to it, with each link's own keys",
  "schema": {
    "type": "object",
    "required": [
      "application_id",
      "nrn"
    ],
    "properties": {
      "application_id": {
        "type": "string",
        "primaryKey": true,
        "autoGenerate": false,
        "pattern": "^\\d+$",
        "description": "The application id; must equal the application= segment of nrn (the worker checks it)"
      },
      "nrn": {
        "type": "string",
        "nrn": true,
        "pattern": "^organization=\\d+:account=\\d+:namespace=\\d+:application=\\d+$",
        "description": "The application NRN, exactly (never a namespace or above)"
      }
    },
    "actions": {
      "list-objects": {
        "name": "List objects",
        "execution": "sync",
        "input": {
          "type": "object",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "additionalProperties": false,
          "required": [
            "linkId"
          ],
          "properties": {
            "linkId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,64}$",
              "title": "Link",
              "description": "Id of the application's link to the bucket; S3 is opened with that link's keys"
            },
            "prefix": {
              "type": "string",
              "maxLength": 1024,
              "pattern": "^[^/]",
              "title": "Prefix",
              "description": "Relative key prefix, usually ending in /"
            },
            "token": {
              "type": "string",
              "title": "Continuation token"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 200,
              "title": "Limit"
            }
          }
        },
        "output": {
          "type": "object",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "required": [
            "bucket",
            "region",
            "prefix",
            "folders",
            "objects",
            "next_token",
            "truncated"
          ],
          "properties": {
            "bucket": {
              "type": "string"
            },
            "region": {
              "type": [
                "string",
                "null"
              ]
            },
            "prefix": {
              "type": "string"
            },
            "folders": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "prefix",
                  "name"
                ],
                "properties": {
                  "prefix": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            },
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "name",
                  "size",
                  "last_modified"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "size": {
                    "type": "number"
                  },
                  "last_modified": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "storage_class": {
                    "type": "string"
                  },
                  "etag": {
                    "type": "string"
                  }
                }
              }
            },
            "next_token": {
              "type": [
                "string",
                "null"
              ]
            },
            "truncated": {
              "type": "boolean"
            }
          }
        }
      },
      "search-objects": {
        "name": "Search objects",
        "execution": "sync",
        "input": {
          "type": "object",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "additionalProperties": false,
          "required": [
            "linkId",
            "query"
          ],
          "properties": {
            "linkId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,64}$",
              "title": "Link",
              "description": "Id of the application's link to the bucket; S3 is opened with that link's keys"
            },
            "prefix": {
              "type": "string",
              "maxLength": 1024,
              "pattern": "^[^/]",
              "title": "Prefix",
              "description": "The folder to search, at any depth: a relative key prefix, usually ending in /"
            },
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S",
              "title": "Query",
              "description": "The text a file's or folder's name must contain, whatever its case"
            },
            "token": {
              "type": "string",
              "maxLength": 1024,
              "title": "Continuation token",
              "description": "The next_token of the previous call of this search"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 200,
              "title": "Limit",
              "description": "How many matches end the call"
            }
          }
        },
        "output": {
          "type": "object",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "required": [
            "bucket",
            "region",
            "prefix",
            "query",
            "folders",
            "objects",
            "scanned",
            "next_token",
            "truncated"
          ],
          "properties": {
            "bucket": {
              "type": "string"
            },
            "region": {
              "type": [
                "string",
                "null"
              ]
            },
            "prefix": {
              "type": "string"
            },
            "query": {
              "type": "string"
            },
            "folders": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "prefix",
                  "name"
                ],
                "properties": {
                  "prefix": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            },
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "name",
                  "size",
                  "last_modified"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "size": {
                    "type": "number"
                  },
                  "last_modified": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "storage_class": {
                    "type": "string"
                  },
                  "etag": {
                    "type": "string"
                  }
                }
              }
            },
            "scanned": {
              "type": "integer"
            },
            "next_token": {
              "type": [
                "string",
                "null"
              ]
            },
            "truncated": {
              "type": "boolean"
            }
          }
        }
      },
      "head-object": {
        "name": "Head object",
        "execution": "sync",
        "input": {
          "type": "object",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "additionalProperties": false,
          "required": [
            "linkId",
            "key"
          ],
          "properties": {
            "linkId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,64}$",
              "title": "Link",
              "description": "Id of the application's link to the bucket; S3 is opened with that link's keys"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^/].*[^/]$|^[^/]$",
              "title": "Key",
              "description": "Relative object key (no leading or trailing slash)"
            }
          }
        },
        "output": {
          "type": "object",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "required": [
            "key",
            "size",
            "last_modified",
            "metadata"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "size": {
              "type": "number"
            },
            "content_type": {
              "type": "string"
            },
            "last_modified": {
              "type": [
                "string",
                "null"
              ]
            },
            "etag": {
              "type": "string"
            },
            "storage_class": {
              "type": "string"
            },
            "metadata": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      },
      "presign-download": {
        "name": "Presign download",
        "execution": "sync",
        "input": {
          "type": "object",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "additionalProperties": false,
          "required": [
            "linkId",
            "key"
          ],
          "properties": {
            "linkId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,64}$",
              "title": "Link",
              "description": "Id of the application's link to the bucket; S3 is opened with that link's keys"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^/].*[^/]$|^[^/]$",
              "title": "Key",
              "description": "Relative object key (no leading or trailing slash)"
            },
            "disposition": {
              "type": "string",
              "enum": [
                "attachment",
                "inline"
              ],
              "default": "attachment",
              "title": "Disposition",
              "description": "attachment (default): a download link. inline: a short-lived link that shows the file as plain text"
            }
          }
        },
        "output": {
          "type": "object",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "required": [
            "key",
            "url",
            "expires_at"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "expires_at": {
              "type": "string"
            }
          }
        }
      },
      "presign-upload": {
        "name": "Presign upload",
        "execution": "sync",
        "input": {
          "type": "object",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "additionalProperties": false,
          "required": [
            "linkId",
            "key",
            "size"
          ],
          "properties": {
            "linkId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,64}$",
              "title": "Link",
              "description": "Id of the application's link to the bucket; S3 is opened with that link's keys"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^/].*[^/]$|^[^/]$",
              "title": "Key",
              "description": "Relative object key (no leading or trailing slash, no ${filename})",
              "not": {
                "pattern": "\\$\\{filename\\}"
              }
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "title": "Size",
              "description": "Size of the file in bytes; the form uploads a file of exactly this size"
            },
            "contentType": {
              "type": "string",
              "maxLength": 127,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,62}/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,62}$",
              "title": "Content type",
              "description": "Media type S3 stores for the object, such as text/csv"
            }
          }
        },
        "output": {
          "type": "object",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "required": [
            "key",
            "url",
            "fields",
            "expires_at"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "value"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            },
            "expires_at": {
              "type": "string"
            }
          }
        }
      }
    },
    "authorization": {
      "entities": {
        "grants": [
          {
            "principals": [
              {
                "type": "*"
              }
            ],
            "actions": [
              "action:list-objects",
              "action:search-objects",
              "action:head-object",
              "action:presign-download",
              "action:presign-upload"
            ]
          }
        ]
      }
    }
  }
}
